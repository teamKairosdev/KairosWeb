---
const siteUrl = 'https://kairos.rhee.life/';
const title = 'Kairos | 초개인화 근거 기반 AI 커리어 에이전트';
const description = 'Kairos는 채용공고 분석부터 경험 근거 매칭, 자가 검증, 버전 관리, 면접 준비까지 일관된 맥락으로 연결하는 AI 커리어 작업공간입니다.';

const tabs = [
  {
    id: 'research',
    label: '회사·직무 조사',
    title: '지원할 기업과 직무를\n먼저 깊이 이해하도록',
    body: '지원회사의 최근 사업 동향과 직무의 핵심 요건을 정교하게 분석합니다. 공고 원문의 숨은 평가 기준을 분석하여 준비의 기초로 삼습니다.',
    accent: 'yellow',
  },
  {
    id: 'matching',
    label: '경험 근거 매칭',
    title: '파편화된 프로젝트 이력에서\n증명 가능한 근거 추출',
    body: '노션, 깃허브, PDF 등에 흩어진 이력을 채용 요건과 일대일로 연결합니다. 사용자의 실제 행동과 성과에 기반한 팩트 카드를 생성합니다.',
    accent: 'blue',
  },
  {
    id: 'verification',
    label: '자가 검증 엔진',
    title: 'AI의 허위 작성을 차단하는\n백그라운드 출처 검증',
    body: '라이너(Liner)의 검색 인용 기법처럼, 생성된 자소서 문장이 경험 자료실의 실제 팩트와 부합하는지 백그라운드에서 실시간으로 대조하고 보완합니다.',
    accent: 'mint',
  },
];

const products = [
  {
    id: 'analysis',
    nav: '공고 분석',
    name: '공고 분석 & 요건 구조화',
    kicker: '정보 조사 기반의 선행 학습',
    description: '기업의 주요 비즈니스 모델, 최신 동향과 직무기술서(JD)를 입체적으로 분석합니다. 필수/우대 역량뿐만 아니라 면접에서 다룰 평가 포인트를 카드로 도출합니다.',
    color: '#e8f3ff',
    accent: '#306bff',
    visual: 'chat',
  },
  {
    id: 'fact-mapping',
    nav: '경험 매칭',
    name: '경험 자료실 & 팩트 매칭',
    kicker: '실제 행동 중심의 역량 증명',
    description: '개인의 업무, 프로젝트, 배운 점을 상황(S)·행동(A)·결과(R)·산출물(E) 카드로 정렬합니다. 채용 요건과 연결하여 근거가 부족한 과장 서술을 미연에 방지합니다.',
    color: '#ddede2',
    accent: '#00906c',
    visual: 'call',
  },
  {
    id: 'canvas',
    nav: '부분 편집',
    name: 'Deep Agent Canvas',
    kicker: '사용자가 온전히 지배하는 에디터',
    description: 'AI에게 전체 문서 변경을 맡기지 마세요. 원하는 특정 영역만 블록 지정해 고치고, 변경 사항을 실시간 인라인 diff로 비교하며 히스토리를 버전별로 관리 및 복원합니다.',
    color: '#fff9e8',
    accent: '#fe5a14',
    visual: 'crm',
  },
  {
    id: 'interview',
    nav: '면접 대비',
    name: 'AI 모의면접 & 피드백 순환',
    kicker: '이력서 기반 맞춤 질문과 양방향 피드백',
    description: '작성된 지원서를 바탕으로 예상 질문을 구성하여 가상 인터뷰를 치릅니다. AI 피드백에 대해 사용자가 해명이나 수정 의견을 더해 다음 답변에 영구적으로 반영시킵니다.',
    color: '#fcf9fb',
    accent: '#7f1fed',
    visual: 'engage',
  },
];

const faqs = [
  ['Kairos의 미션과 비전은 무엇인가요?', 'AI의 환각(거짓말)을 없애고, 구직자가 가진 실제 경험의 근거를 찾아 고유한 이력서와 면접 준비를 유기적으로 완성하여 취업 성공과 성장을 돕는 것입니다.'],
  ['기존 AI 자소서 생성기나 면접 서비스와의 차별점은 무엇인가요?', '단순 문장 생성이 아니라 회사의 사전 조사부터 시작하여 본인의 진짜 경험 근거(Fact)만 활용하도록 제약하고, 캔버스를 통한 버전 관리와 면접 피드백 의견 반영까지 하나의 유기적인 흐름으로 이어집니다.'],
  ['경험 자료는 어떻게 입력하나요?', '완성된 이력서 파일을 업로드하거나, 노션이나 깃허브 등 흩어져 있는 프로젝트 내용, 혹은 일상의 기록을 텍스트로 자유롭게 적어두면 AI가 팩트 카드 형식으로 자동 구조화합니다.'],
  ['자가 검증 엔진은 어떻게 작동하나요?', '라이너(Liner)의 검색 검증처럼 AI가 문서를 제안한 후 백그라운드에서 실시간으로 "경험 자료실"의 사실 정보와 문장 단위로 일대일 대조를 실행해 출처를 표기하고 환각을 차단합니다.'],
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        --yellow: #fff000;
        --light-blue: #0D50E5;
        --medium-blue: #00007E;
        --dark-blue: #00005A;
        --ink: var(--dark-blue);
        --surface: #f5f8ff;
        --muted: #777;
        --line: rgba(0, 0, 90, 0.14);
        --max: 1320px;
        --shadow: 0 20px 60px rgba(0, 0, 90, 0.12);
        font-family: Pretendard, "Noto Sans KR", Inter, system-ui, sans-serif;
        color: var(--ink);
        background: var(--surface);
        font-synthesis: none;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; background: var(--surface); }
      body { margin: 0; min-width: 320px; background: var(--surface); -webkit-font-smoothing: antialiased; }
      a { color: inherit; text-decoration: none; }
      button { color: inherit; font: inherit; }
      .skip-link { position: fixed; left: 16px; top: -100px; z-index: 100; padding: 10px 16px; border-radius: 8px; background: var(--ink); color: white; }
      .skip-link:focus { top: 16px; }
      .wrap { width: min(var(--max), calc(100% - 48px)); margin: 0 auto; }
      .eyebrow { margin: 0 0 18px; font-size: 14px; font-weight: 700; letter-spacing: -0.02em; }
      .section-title { margin: 0; font-size: clamp(32px, 4vw, 52px); line-height: 1.16; letter-spacing: -0.055em; white-space: pre-line; }
      .section-copy { color: #484848; font-size: 18px; line-height: 1.6; letter-spacing: -0.03em; }

      .site-header { position: fixed; top: 8px; left: 50%; z-index: 50; width: min(1080px, calc(100% - 16px)); transform: translateX(-50%); pointer-events: none; }
      .site-nav { display: flex; height: 56px; align-items: center; gap: 20px; padding: 10px 12px; border-radius: 10px; background: rgba(13, 80, 229, 0.94); color: #fff; box-shadow: 0 8px 24px rgba(0,0,90,.16); backdrop-filter: blur(10px); pointer-events: auto; }
      .brand { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 7px; font-size: 18px; font-weight: 900; letter-spacing: -0.08em; }
      .brand-mark { display: grid; width: 28px; height: 28px; place-items: center; border-radius: 8px; background: var(--dark-blue); color: #fff; font-size: 12px; letter-spacing: -0.08em; }
      .nav-links { display: flex; flex: 1; justify-content: center; gap: clamp(14px, 2.3vw, 32px); }
      .nav-links a { position: relative; font-size: 14px; font-weight: 700; letter-spacing: -0.04em; }
      .nav-links a::after { position: absolute; bottom: -7px; left: 0; width: 0; height: 2px; border-radius: 2px; background: #fff; content: ""; transition: width .2s ease; }
      .nav-links a:hover::after, .nav-links a:focus-visible::after { width: 100%; }
      .nav-cta, .button-dark { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; gap: 8px; min-height: 38px; padding: 0 14px; border-radius: 9px; background: var(--ink); color: white; font-size: 14px; font-weight: 700; letter-spacing: -0.04em; transition: transform .2s ease, background .2s ease; }
      .nav-cta:hover, .button-dark:hover { background: #343434; transform: translateY(-2px); }
      .menu-button { display: none; margin-left: auto; border: 0; background: transparent; font-size: 22px; line-height: 1; cursor: pointer; }

      .hero { position: relative; min-height: 100svh; overflow: hidden; background: var(--light-blue); color: #fff; }
      .hero::before { position: absolute; inset: 0; background: radial-gradient(circle at 83% 22%, rgba(255,255,255,.32), transparent 24%), linear-gradient(115deg, transparent 45%, rgba(255,255,255,.14) 45%, transparent 70%); content: ""; }
      .hero-grid { position: relative; z-index: 1; display: grid; min-height: 100svh; grid-template-columns: minmax(0, 1fr) minmax(420px, .92fr); align-items: center; gap: 40px; padding: 136px 0 88px; }
      .hero-copy { max-width: 720px; }
      .hero-title { max-width: 760px; margin: 0; font-size: clamp(58px, 8.4vw, 126px); font-weight: 850; line-height: .94; letter-spacing: -0.075em; }
      .hero-title em { color: #fff; font-style: normal; text-shadow: 4px 4px 0 var(--dark-blue); }
      .hero-subtitle { max-width: 510px; margin: 32px 0 0; font-size: clamp(18px, 2vw, 26px); font-weight: 600; line-height: 1.45; letter-spacing: -0.055em; }
      .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 36px; }
      .button-yellow { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 20px; border: 1px solid #fff; border-radius: 10px; background: #fff; color: var(--dark-blue); font-size: 16px; font-weight: 800; letter-spacing: -0.04em; transition: transform .2s ease, box-shadow .2s ease; }
      .button-yellow:hover { box-shadow: 4px 4px 0 var(--ink); transform: translate(-2px, -2px); }
      .hero-note { display: flex; align-items: center; gap: 8px; margin-top: 60px; font-size: 13px; font-weight: 700; }
      .hero-note::before { width: 7px; height: 7px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 5px rgba(255, 255, 255, .2); content: ""; }
      .hero-art { position: relative; min-height: 520px; }
      .hero-glow { position: absolute; top: 50%; left: 50%; width: 520px; height: 520px; border-radius: 50%; background: rgba(255,255,255,.48); filter: blur(6px); transform: translate(-50%, -50%); }
      .orbit { position: absolute; top: 50%; left: 50%; width: 470px; height: 470px; border: 1px solid rgba(23,23,23,.18); border-radius: 50%; transform: translate(-50%, -50%) rotate(-22deg); }
      .orbit::before, .orbit::after { position: absolute; width: 13px; height: 13px; border-radius: 50%; background: var(--ink); content: ""; }
      .orbit::before { top: 12%; left: 7%; }
      .orbit::after { right: 4%; bottom: 18%; background: var(--dark-blue); }
      .ai-window { position: absolute; top: 50%; left: 50%; width: min(420px, 88%); overflow: hidden; border: 2px solid var(--ink); border-radius: 22px; background: rgba(255,255,255,.84); box-shadow: 12px 18px 0 rgba(23,23,23,.13); transform: translate(-50%, -50%) rotate(4deg); }
      .window-top { display: flex; align-items: center; gap: 7px; padding: 16px 18px; border-bottom: 1px solid rgba(23,23,23,.14); background: white; }
      .window-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--ink); }
      .window-title { margin-left: auto; font-size: 13px; font-weight: 800; }
      .chat-body { display: flex; flex-direction: column; gap: 14px; padding: 28px 22px 24px; }
      .chat-label { width: fit-content; padding: 6px 10px; border-radius: 7px; background: var(--light-blue); color: #fff; font-size: 12px; font-weight: 800; }
      .chat-message { max-width: 80%; padding: 12px 14px; border-radius: 14px 14px 14px 3px; background: #f0f0f0; font-size: 15px; font-weight: 600; line-height: 1.4; letter-spacing: -0.04em; }
      .chat-message.user { align-self: flex-end; border-radius: 14px 14px 3px 14px; background: var(--ink); color: white; }
      .chat-input { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; padding: 10px 12px; border: 1px solid rgba(23,23,23,.14); border-radius: 10px; color: #a1a1a1; font-size: 12px; }
      .send-icon { display: grid; width: 26px; height: 26px; place-items: center; border-radius: 7px; background: var(--light-blue); color: #fff; font-weight: 900; }
      .float-card { position: absolute; display: flex; align-items: center; gap: 10px; padding: 12px 14px; border: 1px solid rgba(23,23,23,.16); border-radius: 14px; background: rgba(255,255,255,.78); box-shadow: 0 14px 24px rgba(23,23,23,.1); backdrop-filter: blur(8px); font-size: 13px; font-weight: 800; letter-spacing: -0.04em; }
      .float-card span { display: grid; width: 30px; height: 30px; place-items: center; border-radius: 9px; background: var(--dark-blue); color: #fff; font-size: 12px; }
      .float-card.one { top: 20%; left: 0; transform: rotate(-8deg); }
      .float-card.two { right: 0; bottom: 23%; transform: rotate(8deg); }
      .scroll-cue { position: absolute; bottom: 25px; left: 50%; display: flex; align-items: center; gap: 10px; color: var(--ink); font-size: 12px; font-weight: 800; letter-spacing: .05em; transform: translateX(-50%); }
      .scroll-cue::after { width: 32px; height: 1px; background: var(--ink); content: ""; }

      .ai-tech { padding: 116px 0 124px; background: var(--surface); }
      .center-heading { max-width: 800px; margin: 0 auto; text-align: center; }
      .center-heading .section-copy { max-width: 630px; margin: 24px auto 0; }
      .tab-list { display: flex; width: fit-content; max-width: 100%; margin: 52px auto 42px; padding: 4px; border: 1px solid var(--line); border-radius: 14px; overflow-x: auto; }
      .tab-button { border: 0; border-radius: 10px; padding: 13px 18px; background: transparent; cursor: pointer; font-size: 15px; font-weight: 800; white-space: nowrap; letter-spacing: -0.05em; transition: background .2s ease, color .2s ease; }
      .tab-button[aria-selected="true"] { background: var(--yellow); color: var(--ink); }
      .tab-panel { display: none; grid-template-columns: minmax(0, .82fr) minmax(380px, 1.18fr); align-items: center; gap: 50px; max-width: 1200px; margin: 0 auto; padding: 34px; border-radius: 20px; background: white; box-shadow: var(--shadow); }
      .tab-panel.active { display: grid; }
      .tab-panel h3 { margin: 0; white-space: pre-line; font-size: clamp(28px, 4vw, 48px); line-height: 1.08; letter-spacing: -0.07em; }
      .tab-panel p { margin: 24px 0 0; color: #555; font-size: 16px; line-height: 1.7; letter-spacing: -0.04em; }
      .tab-visual { position: relative; min-height: 310px; overflow: hidden; border-radius: 15px; background: #eef0f7; }
      .tab-panel[data-accent="yellow"] .tab-visual { background: var(--yellow); }
      .tab-panel[data-accent="blue"] .tab-visual { background: #e8f3ff; }
      .tab-panel[data-accent="mint"] .tab-visual { background: #ddede2; }
      .mini-dashboard { position: absolute; top: 50%; left: 50%; width: 74%; padding: 18px; border: 1px solid rgba(23,23,23,.14); border-radius: 16px; background: rgba(255,255,255,.83); box-shadow: 8px 10px 0 rgba(23,23,23,.12); transform: translate(-50%, -50%) rotate(-4deg); }
      .mini-dashboard .bar { height: 8px; margin-bottom: 12px; border-radius: 4px; background: #d8d8d8; }
      .mini-dashboard .bar.short { width: 42%; }
      .mini-row { display: grid; grid-template-columns: 1fr .6fr; gap: 10px; margin-top: 12px; }
      .mini-box { height: 72px; border-radius: 10px; background: #f2f2f2; }
      .mini-box.highlight { background: var(--yellow); }
      .mini-bubble { position: absolute; right: 10%; bottom: 16%; display: grid; width: 54px; height: 54px; place-items: center; border: 2px solid var(--ink); border-radius: 50%; background: white; font-size: 20px; font-weight: 900; }

      .products { padding: 112px 0 132px; background: white; }
      .products-intro { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 62px; }
      .products-intro .section-copy { max-width: 420px; margin: 0; }
      .product-layout { display: grid; grid-template-columns: 126px minmax(0, 1fr); gap: 62px; }
      .product-nav { position: sticky; top: 104px; align-self: start; display: flex; flex-direction: column; gap: 22px; }
      .product-nav a { position: relative; width: fit-content; color: #8d8d8d; font-size: 16px; font-weight: 800; letter-spacing: -0.05em; transform-origin: left center; transition: color .25s ease, transform .25s ease; }
      .product-nav a::before { position: absolute; top: 50%; left: -16px; width: 0; height: 2px; background: var(--ink); content: ""; transition: width .2s ease; }
      .product-nav a:hover, .product-nav a:focus-visible, .product-nav a.is-active { color: var(--ink); }
      .product-nav a:hover::before, .product-nav a:focus-visible::before, .product-nav a.is-active::before { width: 10px; }
      .product-nav a.is-active { transform: scale(1.14); }
      .product-list { display: flex; flex-direction: column; gap: 84px; }
      .product-card { scroll-margin-top: 110px; }
      .product-visual { position: relative; min-height: 420px; overflow: hidden; border-radius: 16px; background: var(--card-color); }
      .product-visual::after { position: absolute; right: 0; bottom: -120px; width: 430px; height: 430px; border: 1px solid rgba(23,23,23,.12); border-radius: 50%; content: ""; }
      .visual-window { position: absolute; top: 50%; left: 50%; z-index: 1; width: min(70%, 570px); min-height: 260px; padding: 20px; border: 1px solid rgba(23,23,23,.15); border-radius: 16px; background: rgba(255,255,255,.83); box-shadow: 10px 12px 0 rgba(23,23,23,.1); transform: translate(-50%, -50%) rotate(-3deg); }
      .visual-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; font-size: 12px; font-weight: 800; }
      .visual-header span { width: 34px; height: 8px; border-radius: 8px; background: var(--accent); }
      .visual-content { display: grid; grid-template-columns: .75fr 1.25fr; gap: 14px; }
      .visual-side, .visual-main { min-height: 170px; border-radius: 10px; background: rgba(23,23,0,.07); }
      .visual-main { padding: 15px; background: rgba(255,255,255,.8); }
      .visual-line { height: 9px; margin-bottom: 12px; border-radius: 6px; background: rgba(23,23,23,.15); }
      .visual-line.accent { width: 52%; background: var(--accent); }
      .visual-chart { display: flex; align-items: end; gap: 7px; height: 110px; padding: 14px 0 0; }
      .visual-chart i { display: block; flex: 1; border-radius: 5px 5px 0 0; background: var(--accent); opacity: .78; }
      .visual-chart i:nth-child(1) { height: 38%; }
      .visual-chart i:nth-child(2) { height: 62%; }
      .visual-chart i:nth-child(3) { height: 47%; }
      .visual-chart i:nth-child(4) { height: 88%; }
      .visual-chart i:nth-child(5) { height: 71%; }
      .visual-chat { display: flex; flex-direction: column; gap: 10px; padding-top: 6px; }
      .visual-chat b { align-self: flex-end; width: 60%; height: 26px; border-radius: 9px 9px 2px 9px; background: var(--accent); opacity: .75; }
      .visual-chat span { width: 76%; height: 32px; border-radius: 9px 9px 9px 2px; background: rgba(23,23,23,.12); }
      .product-copy { position: relative; padding: 30px 120px 0 0; }
      .product-kicker { display: block; margin-bottom: 8px; font-size: 16px; font-weight: 800; letter-spacing: -0.04em; }
      .product-name { margin: 0; font-size: clamp(28px, 4vw, 42px); line-height: 1.1; letter-spacing: -0.07em; }
      .product-description { max-width: 760px; margin: 17px 0 0; color: #4c4c4c; font-size: 16px; line-height: 1.7; letter-spacing: -0.04em; }
      .product-link { position: absolute; top: 30px; right: 0; display: inline-flex; align-items: center; gap: 8px; min-height: 42px; padding: 0 14px; border: 1px solid #d4d4d4; border-radius: 9px; background: white; font-size: 14px; font-weight: 800; transition: box-shadow .2s ease, transform .2s ease; }
      .product-link:hover { box-shadow: 4px 4px 0 var(--ink); transform: translate(-2px, -2px); }

      .proof { position: relative; overflow: hidden; padding: 116px 0 110px; background: var(--ink); color: white; }
      .proof::before { position: absolute; top: -180px; right: -80px; width: 520px; height: 520px; border: 1px solid rgba(13,80,229,.42); border-radius: 50%; box-shadow: 0 0 0 55px rgba(13,80,229,.12), 0 0 0 110px rgba(13,80,229,.06); content: ""; }
      .proof .eyebrow { color: var(--light-blue); }
      .proof .section-title { max-width: 720px; }
      .proof-grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 80px; }
      .proof-card { min-height: 250px; padding: 28px; border-radius: 16px; color: var(--ink); }
      .proof-card:nth-child(1) { background: linear-gradient(145deg, #dbe7ff, #b9ceff); color: var(--dark-blue); }
      .proof-card:nth-child(2) { background: linear-gradient(145deg, var(--light-blue), #0a43be); color: #fff; }
      .proof-card:nth-child(3) { background: linear-gradient(145deg, var(--medium-blue), var(--dark-blue)); color: #fff; }
      .proof-value { display: block; margin-bottom: 18px; font-size: clamp(48px, 6vw, 86px); font-weight: 850; line-height: .95; letter-spacing: -0.08em; }
      .proof-card p { max-width: 230px; margin: 0; font-size: 16px; font-weight: 800; line-height: 1.45; letter-spacing: -0.05em; }

      .switchon { position: relative; overflow: hidden; padding: 140px 0; background: white; text-align: center; }
      .switchon::before { position: absolute; top: 50%; left: 50%; width: 690px; height: 690px; border: 1px solid rgba(0,0,90,.1); border-radius: 50%; box-shadow: 0 0 0 70px rgba(0,0,90,.035), 0 0 0 150px rgba(0,0,90,.02); content: ""; transform: translate(-50%, -50%); }
      .switchon-content { position: relative; z-index: 1; }
      .switchon .section-title { font-size: clamp(54px, 10vw, 130px); font-weight: 850; line-height: .92; }
      .switch-pill { display: inline-flex; align-items: center; gap: 12px; margin-top: 34px; padding: 13px 18px; border: 1px solid rgba(13,80,229,.28); border-radius: 999px; background: rgba(13,80,229,.1); font-size: 16px; font-weight: 800; }
      .toggle { width: 42px; height: 24px; padding: 3px; border-radius: 999px; background: var(--dark-blue); text-align: left; }
      .toggle::before { display: block; width: 18px; height: 18px; border-radius: 50%; background: var(--light-blue); content: ""; }
      .switchon-copy { max-width: 550px; margin: 28px auto 0; color: #555; font-size: 18px; line-height: 1.65; letter-spacing: -0.04em; }

      .partners { overflow: hidden; padding: 102px 0 92px; background: linear-gradient(#fff, #f4f4f4); }
      .partners h2 { margin: 0 0 38px; text-align: center; font-size: clamp(28px, 4vw, 48px); letter-spacing: -0.07em; }
      .marquee { display: flex; width: max-content; gap: 10px; animation: marquee 32s linear infinite; }
      .marquee-row { overflow: hidden; mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent); }
      .partner-chip { display: grid; width: 208px; height: 108px; place-items: center; border-radius: 14px; background: white; box-shadow: 0 4px 16px rgba(23,23,23,.04); color: #2b2b2b; font-size: 20px; font-weight: 800; letter-spacing: -0.06em; }
      @keyframes marquee { to { transform: translateX(calc(-50% - 5px)); } }

      .stories { padding: 118px 0 130px; background: var(--surface); }
      .stories-heading { display: flex; justify-content: space-between; gap: 30px; align-items: end; }
      .stories-heading p { max-width: 430px; margin: 0; color: #555; font-size: 17px; line-height: 1.65; letter-spacing: -0.04em; }
      .story-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-top: 54px; }
      .story-card { min-height: 250px; padding: 30px; border: 1px solid var(--line); border-radius: 16px; background: white; }
      .story-card:nth-child(2) { background: var(--yellow); }
      .story-card:nth-child(3) { background: #ddede2; }
      .story-card:nth-child(4) { background: #e8f3ff; }
      .story-card blockquote { margin: 0; font-size: 19px; font-weight: 700; line-height: 1.55; letter-spacing: -0.06em; }
      .story-card footer { margin-top: 28px; color: #555; font-size: 14px; font-weight: 700; letter-spacing: -0.04em; }

      .faq { padding: 116px 0 126px; background: white; }
      .faq-layout { display: grid; grid-template-columns: .8fr 1.2fr; gap: 90px; }
      .faq-intro p { max-width: 330px; margin: 26px 0 0; color: #555; font-size: 17px; line-height: 1.65; letter-spacing: -0.04em; }
      .faq-list { border-top: 1px solid var(--ink); }
      .faq-item { border-bottom: 1px solid var(--line); }
      .faq-item summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px 0; cursor: pointer; list-style: none; font-size: 18px; font-weight: 800; letter-spacing: -0.05em; }
      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-item summary::after { width: 24px; height: 24px; border: 1px solid var(--ink); border-radius: 50%; content: "+"; text-align: center; font-size: 18px; font-weight: 400; line-height: 21px; }
      .faq-item[open] summary::after { content: "−"; }
      .faq-item p { max-width: 720px; margin: -4px 40px 24px 0; color: #555; font-size: 16px; line-height: 1.7; letter-spacing: -0.04em; }

      .contact { padding: 108px 0 120px; background: var(--light-blue); color: #fff; }
      .contact-grid { display: flex; align-items: end; justify-content: space-between; gap: 40px; }
      .contact .section-title { max-width: 730px; }
      .contact-copy { max-width: 360px; margin: 0; font-size: 18px; font-weight: 700; line-height: 1.55; letter-spacing: -0.05em; }
      .contact-button { display: inline-flex; align-items: center; justify-content: center; min-height: 54px; margin-top: 32px; padding: 0 22px; border-radius: 10px; background: var(--ink); color: white; font-size: 16px; font-weight: 800; transition: transform .2s ease, background .2s ease; }
      .contact-button:hover { background: #343434; transform: translateY(-3px); }

      .site-footer { padding: 55px 0 32px; background: var(--ink); color: white; }
      .footer-top { display: flex; align-items: start; justify-content: space-between; gap: 40px; padding-bottom: 62px; }
      .footer-brand { color: var(--light-blue); }
      .footer-brand .brand-mark { background: var(--light-blue); color: var(--dark-blue); }
      .footer-columns { display: grid; grid-template-columns: repeat(3, minmax(100px, 1fr)); gap: 70px; }
      .footer-column strong { display: block; margin-bottom: 14px; color: #818181; font-size: 12px; letter-spacing: .02em; }
      .footer-column a, .footer-column p { display: block; margin: 0 0 8px; font-size: 14px; font-weight: 700; letter-spacing: -0.03em; }
      .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.18); color: #8e8e8e; font-size: 12px; }

      @media (min-width: 768px) { .wrap { width: min(var(--max), calc(100% - 104px)); } .site-header { top: 16px; width: min(1080px, calc(100% - 32px)); } .site-nav { height: 60px; padding: 10px 16px; } }
      @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; gap: 10px; } .hero-copy { max-width: 650px; } .hero-art { min-height: 400px; } .hero-glow, .orbit { transform: translate(-50%, -50%) scale(.78); } .product-layout { gap: 34px; } .faq-layout { gap: 42px; } .footer-columns { gap: 28px; } }
      @media (max-width: 700px) {
        .wrap { width: calc(100% - 32px); }
        .site-header { width: calc(100% - 16px); }
        .site-nav { gap: 10px; }
        .brand { font-size: 16px; }
        .brand-mark { width: 26px; height: 26px; }
        .nav-links { position: absolute; top: 62px; right: 0; left: 0; display: none; flex-direction: column; gap: 0; padding: 8px; border-radius: 12px; background: rgba(13,80,229,.98); color: #fff; box-shadow: 0 12px 30px rgba(0,0,90,.2); }
        .nav-links.open { display: flex; }
        .nav-links a { padding: 13px 10px; }
        .nav-links a::after { bottom: 8px; left: 10px; }
        .nav-cta { display: none; }
        .menu-button { display: block; }
        .hero-grid { padding-top: 118px; padding-bottom: 38px; }
        .hero-title { font-size: clamp(52px, 15vw, 84px); }
        .hero-subtitle { margin-top: 22px; font-size: 19px; }
        .hero-note { margin-top: 34px; }
        .hero-art { min-height: 340px; }
        .hero-glow, .orbit { transform: translate(-50%, -50%) scale(.6); }
        .float-card { padding: 9px 10px; font-size: 11px; }
        .float-card.one { left: -3%; }
        .float-card.two { right: -3%; }
        .ai-tech, .products, .proof, .stories, .faq { padding: 82px 0 88px; }
        .section-copy { font-size: 16px; }
        .tab-list { width: 100%; margin-top: 35px; margin-bottom: 28px; }
        .tab-button { flex: 1; padding: 11px 10px; font-size: 12px; }
        .tab-panel { grid-template-columns: 1fr; gap: 28px; padding: 20px; }
        .tab-panel h3 { font-size: 32px; }
        .tab-visual { min-height: 220px; }
        .products-intro, .stories-heading, .contact-grid, .footer-top { display: block; }
        .products-intro .section-copy { margin-top: 20px; }
        .product-layout { display: block; }
        .product-nav { position: static; flex-direction: row; gap: 13px; margin-bottom: 34px; overflow-x: auto; }
        .product-nav a { flex: 0 0 auto; font-size: 14px; }
        .product-nav a::before { display: none; }
        .product-list { gap: 62px; }
        .product-visual { min-height: 270px; }
        .visual-window { width: 80%; min-height: 180px; padding: 14px; }
        .visual-content { gap: 9px; }
        .visual-side, .visual-main { min-height: 110px; }
        .product-copy { padding: 22px 0 0; }
        .product-link { position: static; margin-top: 20px; }
        .proof-grid, .story-grid { grid-template-columns: 1fr; margin-top: 48px; }
        .proof-card { min-height: 210px; }
        .switchon { padding: 100px 0; }
        .switchon::before { width: 430px; height: 430px; }
        .partners { padding: 76px 0 70px; }
        .partner-chip { width: 150px; height: 86px; font-size: 16px; }
        .faq-layout { display: block; }
        .faq-intro { margin-bottom: 48px; }
        .faq-item summary { font-size: 16px; }
        .contact { padding: 80px 0 88px; }
        .contact-copy { margin-top: 24px; }
        .footer-columns { margin-top: 45px; grid-template-columns: repeat(2, 1fr); gap: 32px 20px; }
        .footer-bottom { display: block; }
        .footer-bottom span { display: block; margin-top: 8px; }
      }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; } }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="주요 메뉴">
        <a class="brand" href="#hero" aria-label="Kairos 홈"><span class="brand-mark">K·</span><span>KAIROS</span></a>
        <div class="nav-links" id="nav-links">
          <a href="#about">에이전트 기술</a>
          <a href="#products">주요 기능</a>
          <a href="#stories">이용 후기</a>
          <a href="#faq">FAQ</a>
        </div>
        <a class="nav-cta" href="#contact">시작하기 <span aria-hidden="true">↗</span></a>
        <button class="menu-button" type="button" aria-label="메뉴 열기" aria-controls="nav-links" aria-expanded="false">☰</button>
      </nav>
    </header>

    <main id="main">
      <section id="hero" class="hero" aria-labelledby="hero-title">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">KAIROS — THE OPPORTUNE MOMENT</p>
            <h1 id="hero-title" class="hero-title">나의 진짜 경험을<br /><em>회사의 언어</em>로</h1>
            <p class="hero-subtitle">회사 조사부터 경험 매칭, 자가 검증과 면접 준비까지 하나로 묶는 AI 커리어 에이전트, Kairos</p>
            <div class="hero-actions">
              <a class="button-yellow" href="#contact">에이전트 시작하기 <span aria-hidden="true">↗</span></a>
              <a class="button-dark" href="#products">핵심 기능 보기</a>
            </div>
            <p class="hero-note">내 커리어의 결정적인 순간을 완성하는 파트너</p>
          </div>
          <div class="hero-art" aria-hidden="true">
            <div class="hero-glow"></div>
            <div class="orbit"></div>
            <div class="ai-window">
              <div class="window-top"><span class="window-dot"></span><span class="window-dot"></span><span class="window-dot"></span><span class="window-title">KAIROS / CORE SYSTEM</span></div>
              <div class="chat-body">
                <span class="chat-label">자가 검증 활성화</span>
                <div class="chat-message user">카카오 백엔드 공고에 제 분산 DB 분산 락 구현 프로젝트를 연결해서 자소서 다듬어줘.</div>
                <div class="chat-message">분산 락 프로젝트의 동시성 이슈 제어 경험을 추출해 \'대용량 트래픽 처리\' 요건에 매칭했습니다. 백그라운드 자가 검증을 진행합니다.</div>
                <div class="chat-input"><span>메시지를 입력하세요</span><span class="send-icon">↑</span></div>
              </div>
            </div>
            <div class="float-card one"><span>F</span> FACT MAPPED</div>
            <div class="float-card two"><span>V</span> VERIFIED OK</div>
          </div>
        </div>
        <a class="scroll-cue" href="#about">SCROLL</a>
      </section>

      <section id="about" class="ai-tech" aria-labelledby="about-title">
        <div class="wrap">
          <div class="center-heading">
            <p class="eyebrow">AI-TECH</p>
            <h2 id="about-title" class="section-title">Kairos는 취업 준비의<br />모든 여정에 신뢰를 더합니다</h2>
            <p class="section-copy">AI의 문장 생성을 넘어 사실 기반의 교차 검증과 사용자가 직접 지배하는 편집 인터페이스를 제공하여 본인만의 독보적인 가치를 설계합니다.</p>
          </div>
          <div class="tab-list" role="tablist" aria-label="AI 기술 소개">
            {tabs.map((tab, index) => <button class="tab-button" type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`panel-${tab.id}`} data-tab={tab.id}>{tab.label}</button>)}
          </div>
          {tabs.map((tab, index) => (
            <div id={`panel-${tab.id}`} class:list={["tab-panel", { active: index === 0 }]} data-panel={tab.id} data-accent={tab.accent} role="tabpanel">
              <div><h3>{tab.title}</h3><p>{tab.body}</p><a class="button-dark" href="#contact">시작하기 <span aria-hidden="true">↗</span></a></div>
              <div class="tab-visual"><div class="mini-dashboard"><div class="bar short"></div><div class="bar"></div><div class="mini-row"><div class="mini-box highlight"></div><div class="mini-box"></div></div><div class="mini-row"><div class="mini-box"></div><div class="mini-box"></div></div></div><div class="mini-bubble">✦</div></div>
            </div>
          ))}
        </div>
      </section>

      <section id="products" class="products" aria-labelledby="products-title">
        <div class="wrap">
          <div class="products-intro"><div><p class="eyebrow">FEATURES</p><h2 id="products-title" class="section-title">파편화된 준비를<br />하나의 흐름으로</h2></div><p class="section-copy">자소서 작성, 이력 수정, 모의면접을 따로 놀게 두지 마세요. Kairos는 회사 조사에서 출발해 모든 단계의 데이터를 유기적인 경험으로 결합합니다.</p></div>
          <div class="product-layout">
            <nav class="product-nav" aria-label="제품 목록">{products.map((product) => <a href={`#${product.id}`}>{product.nav}</a>)}</nav>
            <div class="product-list">
              {products.map((product) => (
                <article id={product.id} class="product-card">
                  <div class="product-visual" style={`--card-color:${product.color};--accent:${product.accent}`}>
                    <div class="visual-window">
                      <div class="visual-header"><span></span><b>{product.name}</b><small>● RUNNING</small></div>
                      <div class="visual-content"><div class="visual-side"><div class="visual-chat"><span></span><b></b><span></span></div></div><div class="visual-main"><div class="visual-line accent"></div><div class="visual-line"></div><div class="visual-chart"><i></i><i></i><i></i><i></i><i></i></div></div></div>
                    </div>
                  </div>
                  <div class="product-copy"><span class="product-kicker" style={`color:${product.accent}`}>{product.kicker}</span><h3 class="product-name">{product.name}</h3><p class="product-description">{product.description}</p><a class="product-link" href="#contact">기능 알아보기 <span aria-hidden="true">↗</span></a></div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="proof" aria-labelledby="proof-title">
        <div class="wrap"><p class="eyebrow">THE NUMBERS</p><h2 id="proof-title" class="section-title">경험에 신뢰를 더하는 시간,<br />결과로 증명합니다.</h2><div class="proof-grid"><div class="proof-card"><strong class="proof-value">82%</strong><p>Kairos와 함께 단축된 평균 서류 준비 시간</p></div><div class="proof-card"><strong class="proof-value">0%</strong><p>출처 교차 검증을 통한 자소서 환각 오류율</p></div><div class="proof-card"><strong class="proof-value">91%</strong><p>경험 카드 매칭 기반 모의면접 답변 만족도</p></div></div></div>
      </section>

